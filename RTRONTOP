BtnCorner.CornerRadius = UDim.new(0, 8)
BtnCorner.Parent = ToggleButton

local isEnabled = false
local flySpeed = 70
local currentVelocity = Vector3.zero
local lastRagdollTick = 0

local function updateFlyState(state)
    isEnabled = state
    
    if isEnabled then
        ToggleButton.Text = "Fly:ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 165, 65)

        triggerRagdoll()

        local character = LocalPlayer.Character
        if not character then return end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid then return end

        applyRagdollLogic(character)
        humanoid.PlatformStand = true
        currentVelocity = Vector3.zero
        local lastCamLook = Camera.CFrame.LookVector

        _G.FlyConnection = RunService.RenderStepped:Connect(function(dt)
            if not isEnabled or not character.Parent or not rootPart.Parent then return end
            
            if tick() - lastRagdollTick >= 0.3 then
                lastRagdollTick = tick()
                triggerRagdoll()
            end

            applyRagdollLogic(character)

            local camCF = Camera.CFrame
            local lookV = camCF.LookVector
            local rightV = camCF.RightVector
            local targetDir = Vector3.zero

            pcall(function()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then targetDir = targetDir + lookV end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then targetDir = targetDir - lookV end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then targetDir = targetDir - rightV end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then targetDir = targetDir + rightV end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then targetDir = targetDir + Vector3.yAxis end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then targetDir = targetDir - Vector3.yAxis end
            end)

            if targetDir.Magnitude == 0 and humanoid.MoveDirection.Magnitude > 0 then
                local moveDir = humanoid.MoveDirection
                local localMove = camCF:VectorToObjectSpace(moveDir)
                targetDir = (lookV * -localMove.Z) + (rightV * localMove.X)
            end

            local targetVelocity = targetDir.Magnitude > 0 and (targetDir.Unit * flySpeed) or Vector3.zero
            
            currentVelocity = currentVelocity:Lerp(targetVelocity, math.clamp(dt * 35, 0, 1))
            
            if targetDir.Magnitude == 0 then
                currentVelocity = currentVelocity - Vector3.new(0, 9.8 * dt * 1.2, 0)
            end
            
            rootPart.AssemblyLinearVelocity = currentVelocity

            local camDeltaAngle = lastCamLook:Cross(lookV)
            local targetAngular = Vector3.new(camDeltaAngle.X * 35, camDeltaAngle.Y * 50, camDeltaAngle.Z * 35)
            
            if targetDir.Magnitude > 0 or camDeltaAngle.Magnitude > 0.005 then
                rootPart.AssemblyAngularVelocity = rootPart.AssemblyAngularVelocity:Lerp(targetAngular + Vector3.new(0, 5, 0), math.clamp(dt * 15, 0, 1))
            else
                rootPart.AssemblyAngularVelocity = rootPart.AssemblyAngularVelocity:Lerp(Vector3.zero, math.clamp(dt * 5, 0, 1))
            end

            lastCamLook = lookV
        end)
    else
        if _G.FlyConnection then
            _G.FlyConnection:Disconnect()
            _G.FlyConnection = nil
        end

        currentVelocity = Vector3.zero

        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            
            if humanoid then
                humanoid.PlatformStand = false
                pcall(function()
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
            end

            if rootPart then
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
            end
        end

        triggerRagdoll()

        ToggleButton.Text = "Fly:OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(195, 40, 40)
    end
end

local isProcessing = false
local function toggleFeature()
    if isProcessing then return end
    isProcessing = true
    
	updateFlyState(not isEnabled)
    
    task.delay(0.2, function()
        isProcessing = false
    end)
end

local lastClickTime = 0
local function onClick()
    if tick() - lastClickTime < 0.3 then return end
    lastClickTime = tick()
    toggleFeature()
end

ToggleButton.TouchTap:Connect(onClick)
ToggleButton.MouseButton1Click:Connect(onClick)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.F then
		onClick()
	end
end)

LocalPlayer.CharacterAdded:Connect(function()
	if isEnabled then
		updateFlyState(false)
	end
end)
